# Self-hosted Postiz API configuration for @devremoto.br
POSTIZ_API_URL=https://postiz.luis-carvalho.online/api
# Public API Key (64-char hex generated in Postiz Settings -> Public API). Do NOT use integration ID here!
POSTIZ_API_KEY=
# Social Channel Integration ID (CUID e.g. cmw6m87yh0001qjy4vy20eyss). Leave blank to auto-detect via `postiz integrations:list`
POSTIZ_INSTAGRAM_ID=
